<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#FFFFFF">

    <TextView
        android:id="@+id/tvSuggestedHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Suggested Recipes"
        android:textColor="#212121"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Empty feedback view when 0 recipes match strictly -->
    <TextView
        android:id="@+id/tvEmptySuggestions"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="No recipes match your pantry yet.\n\nAdd more ingredients to your pantry to find recipes you can cook right now!"
        android:textColor="#757575"
        android:textSize="16sp"
        android:visibility="gone" />

    <!-- RecyclerView for matching recipes -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSuggestions"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>